{
  "name": "dsh-suggest-flow",
  "version": "0.1.0",
  "icon": "./icon.png",
  "description": "Smart follow-up suggestions above the DSH composer: Explore / Expand / Apply intent chips, one-click refresh, adoption memory and full keyboard flow.",
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/cordis": "~4.0.4 || ~4.1.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/host-test.mjs && node scripts/render-test.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "files": [
    "icon.png",
    "dsh.plugin.json",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelloDevin/dsh-suggest-flow.git"
  },
  "homepage": "https://github.com/HelloDevin/dsh-suggest-flow#readme",
  "bugs": {
    "url": "https://github.com/HelloDevin/dsh-suggest-flow/issues"
  }
}
